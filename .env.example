# Optional settings. Copy to .env to change any of them.

# Trained model folder inside artifacts/models/
MODEL_VERSION=v1.1.0

# SQLite database (default: backend/var/pneumoscope.db)
# DATABASE_URL=sqlite:///backend/var/pneumoscope.db

# Allowed browser origins for the API in development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limit and CPU threads used for inference
MAX_UPLOAD_MB=10
TORCH_THREADS=4

# Login
# Secret used to sign login sessions (required for Docker). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Optional first account, created automatically on start-up
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
